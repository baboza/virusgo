rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isInstructor() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'instructor';
    }
    
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      // Anyone logged in can read public user data (e.g. for leaderboard), 
      // existing Year 3 users keep full update access, and new user creation is strictly restricted
      // to MSU Year 4 (66...) & Year 5 (65...) @msu.ac.th emails, Instructor jirawat.s@msu.ac.th, and GM never.away@gmail.com.
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && (
          request.auth.token.email == 'never.away@gmail.com'
          || request.auth.token.email == 'wilasinee.c@msu.ac.th'
          || request.auth.token.email == 'jirawat.s@msu.ac.th'
          || request.auth.token.email.matches('^6[56][0-9]{5,12}@msu\\.ac\\.th$')
        );
      allow update: if isOwner(userId) || isInstructor() || isAdmin();
      allow delete: if isAdmin() || isInstructor();

      match /history/{historyId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId) || isInstructor() || isAdmin();
      }
    }

    // Live Classroom Radar Telemetry
    match /live_sessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }

    // Viruses Collection
    match /viruses/{virusId} {
      // All authenticated users can read virus data
      allow read: if isAuthenticated();
      // Only instructors and admins can manage virus database
      allow write: if isInstructor() || isAdmin();
    }

    // Questions Collection
    match /questions/{questionId} {
      // Students can read questions
      allow read: if isAuthenticated();
      // Only instructors can manage questions
      allow write: if isInstructor() || isAdmin();
    }

    // Case Studies
    match /caseStudies/{caseId} {
      allow read: if isAuthenticated();
      allow write: if isInstructor() || isAdmin();
    }

    // Achievements Collection (Static data)
    match /achievements/{achievementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Multiplayer Rooms
    match /rooms/{roomId} {
      allow read, write: if isAuthenticated();
    }
    
    // PvP Duel Rooms
    match /pvp_rooms/{roomId} {
      allow read, write: if isAuthenticated();
    }
    
    // Leaderboard
    match /leaderboard/{entryId} {
      allow read: if isAuthenticated();
      // Should ideally be updated via Cloud Functions, but for simplicity:
      allow write: if isOwner(request.resource.data.uid) || isAdmin();
    }

    // Game Content (quiz pools, world merge config, etc.) - read only for students
    match /game_content/{docId} {
      allow read: if isAuthenticated();
      allow write: if isInstructor() || isAdmin() || (docId == 'empire_world_config' && request.auth.token.email == 'never.away@gmail.com');
    }

    // Empire Map Tiles
    match /empire_tiles/{tileId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Guilds (Alliances)
    match /guilds/{guildId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
